<Page x:Class="TrueSound.view.LibraryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TrueSound.view"
      mc:Ignorable="d" 
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:ie="http://schemas.microsoft.com/xaml/behaviors"
      d:DesignHeight="600" d:DesignWidth="400"
      Title="LibraryPage"
      Background="#FF2A3037"
      ShowsNavigationUI="False"
      >
    <Page.Resources>
        <Style x:Key="srchStyle" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignFilledTextBox}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="Wheat"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Wheat"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Width" Value="250"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="md:HintAssist.Hint" Value="Поиск"/>
        </Style>
        <Style x:Key="albStyle"  TargetType="ListBoxItem">
            <Setter Property="Margin" Value="5 5 5 5"/>
            <Setter Property="BorderBrush" Value="Wheat"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>


        <Style x:Key="albImageStyle" TargetType="Image">
            <Setter Property="Height" Value="60"/>
            <Setter Property="Width" Value="60"/>
        </Style>
        <Style x:Key="albNameStyle" TargetType="Label">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="Wheat"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style x:Key="btnStyle" TargetType="Button">
            <Setter Property="Height" Value="70"/>
        </Style>
        
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="71*"/>
            <RowDefinition Height="529*"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="SearchBox"
            Style="{DynamicResource srchStyle}" 
            Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" 
            Grid.Row="0">
            <TextBox.InputBindings>
                <KeyBinding
                    Gesture="Enter"
                    Command="{Binding SearchCommand}"/>
            </TextBox.InputBindings>
            <ie:Interaction.Triggers>
                <ie:EventTrigger EventName="GotMouseCapture">
                    <ie:InvokeCommandAction Command="{Binding SearchFocusCommand}"/>
                </ie:EventTrigger>
            </ie:Interaction.Triggers>
        </TextBox>

        <ListBox
            x:Name="LibraryListBox"
            Background="#FF2A3037"
            Height="472" VerticalAlignment="Top" 
            Grid.Row="1"
            ItemsSource="{Binding AlbumsPanelView, UpdateSourceTrigger=PropertyChanged}" 
            >
            <!--ItemContainerStyle="{DynamicResource albStyle}"-->
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Button 
                        
                        Height="70"
                        Command="{Binding DataContext.AlbumPressCommand , 
                        RelativeSource={RelativeSource AncestorType=Page}}"
                        CommandParameter="{Binding Path=SelectedIndex, 
                        RelativeSource={RelativeSource AncestorType=ListBox}}"
                        >
                        <!--Style="{DynamicResource btnStyle}" почему меняет остальное? -->
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding ImageSource, UpdateSourceTrigger=PropertyChanged}"
                               Style="{DynamicResource albImageStyle}"
                               />
                        <Label Content="{Binding AlbumName, UpdateSourceTrigger=PropertyChanged}"
                               Style="{DynamicResource albNameStyle}"
                               />
                    </StackPanel>
                        
                    </Button>
                </DataTemplate>
                    
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>
