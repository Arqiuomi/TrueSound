<Window x:Class="TrueSound.view.OpenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TrueSound.view"
        xmlns:model="clr-namespace:TrueSound.model"
        xmlns:vm="clr-namespace:TrueSound.ViewModel"
        xmlns:ie="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Title="OpenWindow" Height="600" Width="400"
        Name="OpenW"
        Background="#FF2A3037">

    <Window.Resources>
        
        <Style TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="Wheat"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style x:Key="txtStyle" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignFilledTextBox}">
            <!--#region NewRegion -->
            <!--<Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border CornerRadius="5" BorderBrush="Wheat" BorderThickness="1">
                                <ContentPresenter/>
                                
                            </Border> 
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>-->
            <!--#endregion-->
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="Wheat"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Wheat"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Width" Value="250"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="md:HintAssist.Hint" Value="Имя пользователя"/>
            <Setter Property="md:ButtonAssist.CornerRadius" Value="20"/>
            <!--<Setter Property="md:HintAssist.Hint" Value="Имя пользователя"/>-->
            <!--<Setter Property="md:HintAssist.FloatingScale" Value="1"/>-->
            <!--<Setter Property="md:HintAssist.HintHorizontalAlignment" Value="Center"/>-->
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="BorderBrush" Value="Wheat"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="BorderBrush" Value="Wheat"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="pswrdStyle" TargetType="PasswordBox" BasedOn="{StaticResource MaterialDesignOutlinedRevealPasswordBox}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="Wheat"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Wheat"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Width" Value="250"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="md:HintAssist.Hint" Value="Пароль"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderThickness" Value="0.5"/>
                    <Setter Property="BorderBrush" Value="Wheat"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="Wheat"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="btnStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="Wheat"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Wheat"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="checkStyle" TargetType="CheckBox">
            <Setter Property="BorderBrush" Value="Wheat"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0 0 10 0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="Wheat"/>
            <!--<Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                                >
                            <Path Stroke="Wheat"
                                  Cursor="Hand"/>
                            <ContentPresenter 
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="Запомнить меня"
                                Margin="0 0 5 0"
                                />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>-->

        </Style>
    </Window.Resources>
    
    <Window.DataContext>
        <vm:OpenViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="92*"/>
            <RowDefinition Height="81*"/>
            <RowDefinition Height="86*"/>
            <RowDefinition Height="86*"/>
            <RowDefinition Height="86*"/>
            <RowDefinition Height="65*"/>
            <RowDefinition Height="65*"/>
            <RowDefinition Height="109*"/>
        </Grid.RowDefinitions>
        <TextBlock HorizontalAlignment="Center" Grid.Row="1"
                   Text="Добро пожаловать в TrueSound!"  Height="37" Width="320"/>
        
        <TextBox x:Name="NameBox"
                 Style="{DynamicResource txtStyle}" 
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                 Grid.Row="2"/>

        
        <!--<ie:Interaction.Triggers>
                <ie:EventTrigger EventName="GotFocus">
                    <ie:InvokeCommandAction Command="{Binding GotFocusCommand}"/>
                </ie:EventTrigger>
                <ie:EventTrigger EventName="LostFocus">
                    <ie:InvokeCommandAction Command="{Binding LostFocusCommand}"/>
                </ie:EventTrigger>
            </ie:Interaction.Triggers>-->
        

        <PasswordBox x:Name="PassBox" 
            Style="{DynamicResource pswrdStyle}"
            md:PasswordBoxAssist.Password="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
             Grid.Row="3" 
            />
        <StackPanel Orientation="Horizontal"
                    Grid.Row="4" HorizontalAlignment="Center">
            <CheckBox 
                IsChecked="{Binding RememberMe, UpdateSourceTrigger=PropertyChanged}"
                      Style="{DynamicResource checkStyle}"
                      Content="Запомнить меня"
                      />
            
        </StackPanel>

        <Button Content="Войти"  Grid.Row="5"
                Style="{DynamicResource btnStyle}"
                Height="40" Width="200" 
                Command="{Binding CheckRegCommand}"/>
        
        <Button Content="Зарегистрироваться" 
                Style="{DynamicResource btnStyle}"
                BorderBrush="Transparent"
                Grid.Row="6" 
                Height="40" Width="200"
                Command="{Binding RegLogMoveCommand}"
                CommandParameter="OpenW"
                />
    </Grid>
</Window>
