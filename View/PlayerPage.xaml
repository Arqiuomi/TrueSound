<Page x:Class="TrueSound.View.PlayerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TrueSound.View"
      xmlns:model="clr-namespace:TrueSound.model"
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="400"
      Title="PlayerPage"
      Background="#FF2A3037"
      >
    <Page.Resources>
        <Style x:Key="BrdrStyle" TargetType="Border">
            <Setter Property="Margin" Value="20 10 20 10"/>
            <Setter Property="BorderBrush" Value="Wheat"/>
            <Setter Property="BorderThickness" Value="0.7"/>
        </Style>
        <Style x:Key="LblStyle" TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="Wheat"/>
        </Style>
        <Style x:Key="SldrStyle" TargetType="Slider" BasedOn="{StaticResource MaterialDesign3.MaterialDesignDiscreteHorizontalSlider}">
            <Setter Property="Margin" Value="20 10 20 0"/>
            <Setter Property="Foreground" Value="Wheat"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="TickFrequency" Value="60"/>
        </Style>

        <Style x:Key="BtnStyle" TargetType="Button">
        </Style>
        
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="85*"/>
            <RowDefinition Height="8*"/>
            <RowDefinition Height="9*"/>
            <RowDefinition Height="16*"/>
        </Grid.RowDefinitions>
        <Border
            Style="{DynamicResource BrdrStyle}">
            <Image Source="/View/vinyl.png"/>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="35*"/>
                <ColumnDefinition Width="232*"/>
                <ColumnDefinition Width="35*"/>
            </Grid.ColumnDefinitions>
            <Label Name="StartTimeLabel"
                Style="{DynamicResource LblStyle}"
                Content="0:00"
                />
            <Slider  x:Name="DurationSlider" 
                Grid.Column="1"
                Style="{DynamicResource SldrStyle}"
            />
            <Label Name="EndTimeLabel"
                Grid.Column="2"
                Style="{DynamicResource LblStyle}"
                Content="0:00"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Button x:Name ="BackBtn"
                Grid.Column="1" 
                Background="Transparent"
                    >
                <Image Source="image/back.png"/>
            </Button>

            <Button x:Name ="PlayStopButton"
                Grid.Column="2" 
                Background="Transparent">
                <Image Source="image/playPause.png"/>
            </Button>

            <Button x:Name ="ForwardButton"
                Grid.Column="3" 
                Background="Transparent">
                <Image Source="image/forward.png"/>
            </Button>
        </Grid>
    </Grid>
</Page>
